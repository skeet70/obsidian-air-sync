{
	"compilerOptions": {
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES6",
		"allowJs": true,
		"strict": true,
		"noImplicitReturns": true,
		"moduleResolution": "bundler",
		"importHelpers": true,
		"noUncheckedIndexedAccess": true,
		"isolatedModules": true,
		"allowSyntheticDefaultImports": true,
		"lib": [
			"DOM",
			"ES2022"
		],
		"paths": {
			"@protontech/crypto": ["./src/backends/protondrive/protontech-crypto.d.ts"],
			"@protontech/crypto/constants": ["./src/backends/protondrive/protontech-crypto.d.ts"],
			"@protontech/crypto/srp": ["./src/backends/protondrive/protontech-crypto.d.ts"],
			"@protontech/crypto/proxy/endpoint/api.ts": ["./src/backends/protondrive/protontech-crypto.d.ts"]
		}
	},
	"include": [
		"src/**/*.ts",
		"tests/**/*.ts"
	]
}
